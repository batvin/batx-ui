# Run scripts/configure.mjs to create .env with a unique random password.
# An empty password is intentional: startup must fail until configured.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
COOKIE_SECURE=false
TRUST_PROXY=false
PUBLIC_ORIGIN=

# Optional Caddy HTTPS profile: use a real DNS name, without scheme or path.
BATX_DOMAIN=
